# Copy to .env.production and fill actual values. Never commit it.
# Public URL is used only to validate requests from the staging hostname.
PUBLIC_SITE_ORIGIN=https://earndeck.ycusriya.online
# Resend settings required for the enquiry and careers forms.
# Leave blank until configured; the forms return 503 instead of pretending to send.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
CAREERS_TO_EMAIL=
